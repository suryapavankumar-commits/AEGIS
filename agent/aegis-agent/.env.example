LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# Rime primary TTS (official LiveKit Rime plugin)
RIME_API_KEY=
RIME_MODEL=coda
RIME_VOICE=celeste
RIME_LANGUAGE=en
RIME_SPEED_ALPHA=0.95
RIME_BASE_URL=wss://users-ws.rime.ai
# Base URL of the web server that hosts /api/call (Twilio caller).
# The agent calls this endpoint to place an emergency phone call.
AEGIS_WEB_BASE_URL=http://localhost:3000
# Optional: enables Google Places hospital search, phone/opening/rating data,
# and driving ETA via the Google Directions API. Keep the key server-side only.
# The key must have the Places API and Directions API enabled.
# Without this key, AEGIS falls back to OpenStreetMap hospital data and
# driving ETA becomes unavailable (distance is still reported).
GOOGLE_MAPS_API_KEY=
